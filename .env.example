# Template. Copy it to .env and fill in the values. Never commit the .env.

APP_ENV=development
PORT=3081

# Local: localhost:5432. Production: host atm-postgres (the container name).
#   Local:      postgresql://km_app:<password>@localhost:5432/km?search_path=km
#   Production: postgresql://km_app:<password>@atm-postgres:5432/km?search_path=km
DATABASE_URL=

# Local machine only, never on the server: the database the integration tests
# run against (scripts/provision-test-db.sql). Without it they are skipped.
#   postgresql://km_app:<password>@localhost:5432/km_test?search_path=km
TEST_DATABASE_URL=

# Auth. Generate the secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Access token: 1 hour. Refresh token: 90 days, renewed on every use, so the
# session only ends after 90 days without opening the app (or on logout).
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=90

# Browsers only. Production: the web's origin, e.g. https://km.atmosferast.com
# (several separated by commas).
CORS_ORIGIN=

# Per-IP limits
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Optional. Where "today" is computed. Default: America/Lima
APP_TIMEZONE=America/Lima

# Optional. Odometer photos on disk, deleted after PHOTO_RETENTION_DAYS.
# Production: /app/data/photos (a Docker volume, see deploy/docker-compose.yml).
PHOTOS_DIR=data/photos
PHOTO_RETENTION_DAYS=90
